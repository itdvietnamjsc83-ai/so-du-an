{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sổ Dự Án",
  "version": "0.1.3",
  "identifier": "vn.sodaan.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Sổ Dự Án", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600, "visible": false, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Quản lý dự án offline",
    "copyright": "© 2026",
    "windows": { "nsis": { "languages": ["Vietnamese", "English"], "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
